[Unit]
Description=HCS boot diagnostics onto the evidence disk
Documentation=docs/V2_STABLE_QA_STATUS.md
# Runs EARLY, and specifically EARLIER THAN THE THING IT DIAGNOSES.
#
# First version of this unit was ordered After=multi-user.target, on the reasoning
# that the desktop should get its chance first. That is wrong, and it was found
# by running it: the boot stops between local-fs.target and multi-user.target, so
# a diagnostic gated on multi-user.target never executes on precisely the boots it
# exists to explain. The evidence disk came back unformatted, which was the only
# way to notice.
#
# basic.target is the right place: real filesystems are mounted, systemd itself is
# up, and anything that can still be waited on has not started yet.
After=basic.target
Before=multi-user.target

[Service]
Type=oneshot
RemainAfterExit=yes
# Runs as root because it formats a block device and reads the journal. It reads
# logs and writes them out; it starts nothing.
ExecStart=/usr/share/hcs/session/boot-diagnostics.sh
# Short: if the disk is missing, the script exits immediately, and a diagnostic
# that hangs is worse than none.
TimeoutStartSec=180
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target