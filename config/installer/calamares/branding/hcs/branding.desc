# HCS Linux Calamares Branding
---
componentName: hcs

strings:
    productName:         "HCS Linux"
    shortProductName:    "HCS"
    version:             "1.0.1"
    shortVersion:        "1.0"
    versionedName:       "HCS Linux 1.0.1"
    shortVersionedName:  "HCS 1.0"
    bootloaderEntryName: "HCS Linux"
    productUrl:          "https://github.com/timfromhcs/hcs-linux"
    supportUrl:          "https://github.com/timfromhcs/hcs-linux/issues"
    knownIssuesUrl:      "https://github.com/timfromhcs/hcs-linux/issues"
    releaseNotesUrl:     "https://github.com/timfromhcs/hcs-linux/releases"

images:
    productLogo:         "/usr/share/hcs/branding/hcs-mark.svg"
    productIcon:         "/usr/share/hcs/branding/hcs-mark.svg"
    productWelcome:      "/usr/share/hcs/branding/hcs.svg"

slideshow:               "show.qml"

style:
   SidebarBackground:    "#0a0c10"
   SidebarText:          "#f8fafc"
