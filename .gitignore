*.sock
*.pid
*.log
*.tmp
*.bak
run/
.cache/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# QA test run dumps
qa/latest/
qa/screenshots/run_*
qa/logs/

# Secrets and local configurations
.env
*.token
*.key
*.pem
credentials.json

# OS files
.DS_Store
Thumbs.db
desktop.ini

config/includes.chroot/usr/bin/*
