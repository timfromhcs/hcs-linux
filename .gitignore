# Models and large binaries (Never commit weights to Git history)
vendor/models/**/*.gguf
vendor/models/**/*.bin
vendor/models/**/*.safetensors
vendor/models/**/*.pt
vendor/models/**/*.pth
vendor/models/**/*.onnx
*.gguf
*.safetensors

