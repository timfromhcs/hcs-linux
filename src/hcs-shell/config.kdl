// HCS Linux - Niri Wayland Compositor Configuration
// Aesthetic: Modern Neural Glass aesthetics, scrollable columns, smooth spring physics
// Adheres to GEMINI.md Section 36-60

output "eDP-1" {
    mode "1920x1080@60.000"
    scale 1.0
}

layout {
    gaps 16
    center-focused-column "never"
    default-column-width { proportion 0.5; }

    focus-ring {
        width 2
        active-color "#38bdf8"
        inactive-color "#1e293b"
    }

    border {
        off
    }
}

animations {
    slowdown 1.0
    window-open { duration-ms 180; curve "ease-out-cubic"; }
    window-close { duration-ms 140; curve "ease-in-cubic"; }
    workspace-switch { duration-ms 220; curve "ease-out-expo"; }
}

prefer-no-csd

spawn-at-startup "quickshell" "-c" "/usr/share/hcs/shell"
spawn-at-startup "hcsd"

binds {
    Mod+Return { spawn "hcs-chat"; }
    Mod+Space  { spawn "hcs-search"; }
    Mod+C      { spawn "hcs-control" "status"; }
    Mod+A      { spawn "quickshell" "-p" "/usr/share/hcs/shell/control_drawer.qml"; }
    Mod+V      { spawn "quickshell" "-p" "/usr/share/hcs/shell/clipboard.qml"; }
    Mod+N      { spawn "quickshell" "-p" "/usr/share/hcs/shell/notifications.qml"; }
    Mod+M      { spawn "hcs-monitor"; }
    Mod+D      { spawn "hcs-diagnose"; }
    Mod+I      { spawn "hcs-rag-ingest"; }
    Mod+T      { spawn "x-terminal-emulator"; }
    Mod+Q      { close-window; }
    Mod+Left   { focus-column-left; }
    Mod+Right  { focus-column-right; }
    Mod+Shift+Left  { move-column-left; }
    Mod+Shift+Right { move-column-right; }
}
